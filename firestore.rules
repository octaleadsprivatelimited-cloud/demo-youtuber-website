rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['Admin','Super Admin'];
    }

    match /tractors/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /brands/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /expertReviews/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /articles/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /articleCategories/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /videos/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /equipment/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /equipmentCategories/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /dealers/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /admins/{userId} { allow read: if owns(userId); allow write: if isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Super Admin'; }
    match /leads/{id} {
      allow create: if request.resource.data.status == 'New'
        && request.resource.data.assignedTo == null
        && request.resource.data.notes == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8;
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
    match /favorites/{id} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if signedIn() && request.auth.uid == resource.data.userId && request.auth.uid == request.resource.data.userId;
    }
    match /heroSlides/{id} { allow read: if resource.data.status in ['published','approved'] || isAdmin(); allow write: if isAdmin(); }
    match /partners/{id} { allow read: if resource.data.status in ['published','approved'] || isAdmin(); allow write: if isAdmin(); }
    match /banners/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /advertisements/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /seo/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /settings/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /homepageSections/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /users/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create: if owns(userId) && !request.resource.data.keys().hasAny(['role','disabled','admin','verified']);
      allow update: if owns(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','disabled','admin','verified']);
      allow delete: if isAdmin();
    }
    match /comparisons/{id} { allow read, create, update, delete: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /newsletterSubscribers/{id} { allow create: if request.resource.data.email is string; allow read, update, delete: if isAdmin(); }
    match /contactMessages/{id} { allow create: if request.resource.data.email is string && request.resource.data.message is string; allow read, update, delete: if isAdmin(); }
    match /notifications/{id} { allow read: if signedIn() && resource.data.userId == request.auth.uid; allow write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}

