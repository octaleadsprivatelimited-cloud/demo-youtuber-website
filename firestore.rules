rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identity helpers ─────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Only the single verified site owner via Google Sign-In
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'rakeshpatel0944@gmail.com';
    }

    function validEmail(email) {
      return email is string && email.size() <= 254
        && email.matches('[^ @]+@[^ @]+[.][^ @]+');
    }

    // Editorial reviewers (disabled – kept as no-op for future use)
    function isEditor() { return false; }

    // ─── Editorial review validation ──────────────────────────────────────────
    function validEditorialReview() {
      let d = request.resource.data;
      return d.status in ['draft', 'published', 'archived']
        && (d.status != 'published' || (
          d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.authorName is string && d.authorName.size() > 0
          && d.excerpt is string && d.excerpt.size() > 0
          && d.body is string && d.body.size() >= 100
          && d.verdict is string && d.verdict.size() > 0
          && d.methodology is string && d.methodology.size() > 0
          && d.score is number && d.score >= 0 && d.score <= 10
          && d.slug is string && d.slug.size() > 0
          && d.tractorId is string
          && exists(/databases/$(database)/documents/tractors/$(d.tractorId))
          && get(/databases/$(database)/documents/tractors/$(d.tractorId)).data.status == 'published'
        ));
    }

    // ─── Public catalog ───────────────────────────────────────────────────────
    match /tractors/{id} {
      allow read: if resource.data.status == 'published' || isAdmin() || isEditor();
      allow write: if isAdmin();
    }
    match /brands/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /equipment/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /equipmentCategories/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /dealers/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Editorial content ────────────────────────────────────────────────────
    match /expertReviews/{id} {
      allow read: if resource.data.status == 'published' || isAdmin() || isEditor();
      allow create, update: if (isAdmin() || isEditor()) && validEditorialReview();
      allow delete: if isAdmin() || isEditor();
    }
    match /articles/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /articleCategories/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /videos/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Homepage & site layout ───────────────────────────────────────────────
    match /heroSlides/{id} {
      allow read: if resource.data.status in ['published', 'approved'] || isAdmin();
      allow write: if isAdmin();
    }
    match /partners/{id} {
      allow read: if resource.data.status in ['published', 'approved'] || isAdmin();
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /advertisements/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /homepageSections/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Site configuration (read-only publicly, no public writes) ────────────
    // Only published configuration is public; only the owner can edit it.
    match /seo/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ─── Admin-only collections ───────────────────────────────────────────────
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Owner may inspect accounts; mutations are managed by callable functions.
    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Enquiries / leads ────────────────────────────────────────────────────
    match /leads/{id} {
      // Anyone can submit an enquiry but cannot pre-fill admin fields
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'city', 'state', 'tractorId', 'tractorName', 'dealerId', 'message', 'source', 'userId', 'status', 'assignedTo', 'notes', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('userId' in request.resource.data) || (signedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 10000
        && request.resource.data.status == 'New'
        && request.resource.data.assignedTo == null
        && request.resource.data.notes == ''
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 30;
      allow read, update, delete: if isAdmin();
    }
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 200
        && validEmail(request.resource.data.email)
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('phone', '').size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 10000;
      allow read, update, delete: if isAdmin();
    }
    match /newsletterSubscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'status', 'createdAt'])
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && validEmail(request.resource.data.email);
      allow read, update, delete: if isAdmin();
    }

    // ─── Signed-in user features ──────────────────────────────────────────────
    match /favorites/{id} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.auth.uid == request.resource.data.userId;
    }
    match /comparisons/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // ─── Media storage (images via Firestore base64 store) ────────────────────
    match /media/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if (isAdmin() || (isEditor() && request.resource.data.folder == 'expertReviews'))
        && request.resource.data.keys().hasOnly(['data', 'contentType', 'size', 'folder', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 819200
        && request.resource.data.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 614400
        && request.resource.data.folder is string
        && request.resource.data.folder.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (isEditor() && resource.data.folder == 'expertReviews');
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
